# Local backend configuration. Production values are managed in Render.
ENVIRONMENT=development
DATABASE_URL=
CORS_ORIGINS=

# Local development only; the Render Blueprint generates the production secret.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_MAX_AGE_SECONDS=28800
# Set to true when serving over HTTPS; leave false for local HTTP development.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Optional VirusTotal domain reputation lookups.
VIRUSTOTAL_API_KEY=
